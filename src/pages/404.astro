---
import { url } from '../url';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist.">
  <div class="wrap section"><div class="prose">
    <h1>Page not found</h1>
    <p class="lede">There's no page at this address. It may have moved when the site was rebuilt.</p>
    <p><a class="button" href={url('/')}>Go to the home page</a></p>
  </div></div>
</Base>
