---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  before: { src: ImageMetadata; alt: string };
  after: { src: ImageMetadata; alt: string };
  eager?: boolean;
}

const { before, after, eager = false } = Astro.props;
// The pair always sits side by side, so each photo is roughly half its column.
const sizes = '(min-width: 72rem) 18rem, (min-width: 56rem) 25vw, 50vw';
---

<div class="before-after">
  <figure>
    <Image src={before.src} alt={before.alt} widths={[480, 800, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
    <figcaption>Before</figcaption>
  </figure>
  <figure>
    <Image src={after.src} alt={after.alt} widths={[480, 800, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
    <figcaption>After</figcaption>
  </figure>
</div>

<style>
  .before-after {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  figure {
    position: relative;
    margin: 0;
  }

  img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }

  figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.2em 0.7em;
    border-radius: var(--radius);
    background: var(--maroon);
    color: var(--paper);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step--1);
  }

  figure:first-child figcaption {
    background: var(--paper);
    color: var(--maroon);
  }

  @media (min-width: 40rem) {
    img {
      aspect-ratio: 4 / 5;
    }
  }
</style>
