---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

/**
 * A captioned photo that opens full-size. Without JavaScript the link simply
 * opens the large image; with it, the Lightbox shows it in place.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes: string;
  eager?: boolean;
}

const { src, alt, caption, sizes, eager = false } = Astro.props;
const large = await getImage({ src, width: 1800, format: 'webp' });
---

<figure class="photo">
  <a class="photo__link" href={large.src} data-lightbox data-caption={caption ?? alt}>
    <Image
      src={src}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      class="photo__img"
    />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
  }

  .photo__link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--stone);
    cursor: zoom-in;
  }

  .photo__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .photo__link:hover .photo__img {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--grit);
  }
</style>
