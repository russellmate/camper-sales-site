---
import { Image } from 'astro:assets';
import logo from '../assets/jr-logo.png';
import { business, nav } from '../site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <Image src={logo} alt="" width={72} height={72} densities={[1, 2]} class="brand__logo" loading="eager" />
      <span class="brand__name">{business.name}</span>
    </a>

    <button class="menu-button" type="button" popovertarget="site-nav" aria-controls="site-nav">
      Menu
    </button>

    <nav id="site-nav" class="site-nav" popover aria-label="Main">
      <button
        class="menu-close"
        type="button"
        popovertarget="site-nav"
        popovertargetaction="hide"
      >
        Close
      </button>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --focus: var(--paper);
    background: var(--maroon);
    color: var(--paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--paper);
    text-decoration: none;
  }

  .brand__logo {
    width: 3.5rem;
    height: 3.5rem;
  }

  .brand__name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.1;
    max-width: 9em;
  }

  .menu-button,
  .menu-close {
    font: inherit;
    font-weight: 650;
    padding: 0.5em 1em;
    border: 2px solid currentColor;
    border-radius: var(--radius);
    background: transparent;
    color: var(--paper);
    cursor: pointer;
  }

  /* Mobile: the nav is a popover panel that drops over the page. */
  .site-nav {
    --focus: var(--paper);
    inset: 0 0 auto auto;
    width: min(22rem, 100vw);
    height: 100svh;
    margin: 0;
    padding: var(--space-m);
    border: 0;
    background: var(--maroon);
    color: var(--paper);
    box-shadow: -1rem 0 2rem rgb(0 0 0 / 0.25);
  }

  .site-nav::backdrop {
    background: rgb(36 27 26 / 0.5);
  }

  .menu-close {
    display: block;
    margin-left: auto;
  }

  .site-nav ul {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }

  .site-nav a {
    display: block;
    padding: 0.6rem 0;
    color: var(--paper);
    font-family: var(--font-head);
    font-size: var(--step-2);
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--ply);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.3em;
  }

  /* Desktop: the same nav sits inline in the header. */
  @media (min-width: 56rem) {
    .menu-button,
    .menu-close {
      display: none;
    }

    .brand__logo {
      width: 4.5rem;
      height: 4.5rem;
    }

    .brand__name {
      max-width: none;
    }

    .site-nav {
      display: block;
      position: static;
      width: auto;
      height: auto;
      padding: 0;
      background: none;
      box-shadow: none;
      overflow: visible;
    }

    .site-nav ul {
      display: flex;
      gap: clamp(1rem, 2.5vw, 2rem);
      margin: 0;
    }

    .site-nav a {
      padding: 0.25rem 0;
      font-family: var(--font-body);
      font-size: var(--step-0);
    }
  }
</style>
